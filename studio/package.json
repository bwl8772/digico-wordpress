{
  "name": "digital-command-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "schema:extract": "sanity schema extract --enforce-required-fields --force",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "volta": {
    "extends": "../package.json"
  },
  "dependencies": {
    "@sanity/vision": "^6.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
